# OpenClaw image (official). Pin a release tag for reproducible deployments.
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:latest

# Gateway auth + port.
OPENCLAW_GATEWAY_TOKEN=change-me-in-env
OPENCLAW_GATEWAY_PORT=18789

# --- Chatwoot channel (channels.chatwoot in openclaw.json) ---
CHATWOOT_BASE_URL=https://app.chatwoot.com
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_API_TOKEN=your-chatwoot-user-api-token
CHATWOOT_WEBHOOK_SECRET=change-me-shared-secret

# --- Model provider (OpenClaw gateway, not the plugin) ---
# OPENAI_API_KEY=sk-...
